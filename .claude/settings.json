{
  "enabledPlugins": {
    "gopls-lsp@claude-plugins-official": true,
    "impeccable@impeccable": true
  },
  "hooks": {
    "PostToolUse": [
      {
        "hooks": [
          {
            "command": ".claude/hooks/golangci-lint.sh",
            "statusMessage": "Running golangci-lint…",
            "timeout": 60,
            "type": "command"
          }
        ],
        "matcher": "Write|Edit|MultiEdit"
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "command": "bd prime --hook-json",
            "type": "command"
          }
        ],
        "matcher": ""
      }
    ]
  }
}
